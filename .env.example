# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== Graphiti 记忆图谱配置 =====
# Graphiti 是 Zep 官方开源核心（getzep/graphiti），后端为 Neo4j 5.26。
# 本地运行：docker compose up neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish
# Graphiti 默认复用上方 LLM_API_KEY/LLM_BASE_URL/LLM_MODEL_NAME 做实体/关系抽取；
# 如需为图谱抽取单独指定模型，取消注释以下三行：
# GRAPHITI_LLM_API_KEY=
# GRAPHITI_LLM_BASE_URL=
# GRAPHITI_LLM_MODEL=
GRAPHITI_EMBEDDER_MODEL=text-embedding-3-small
# 自建 OpenAI 兼容网关（如红杉 ai-gateway）：LLM_BASE_URL 指向网关地址即可，
# 自动补 /v1 后缀。网关若对 responses.parse 的 structured output 支持不完整，
# adapter 会自动走 chat.completions.parse 并清洗 input_schema 噪声 + 重试。

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
